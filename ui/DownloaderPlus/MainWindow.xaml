<Window x:Class="DownloaderPlus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Yandex Music Downloader Plus"
        Width="1180" Height="790" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0B1220" BorderBrush="#1F2937" BorderThickness="0,0,1,0">
            <Grid Margin="18,22">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource AccentBrush}" CornerRadius="12" Width="42" Height="42">
                        <TextBlock Text="♫" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="DOWNLOADER" FontSize="13" FontWeight="Bold"/>
                        <TextBlock Text="PLUS" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="2" Text="РАБОЧЕЕ ПРОСТРАНСТВО"
                           FontSize="10" Foreground="#64748B"
                           Margin="5,0,0,10"/>

                <StackPanel Grid.Row="3">
                    <Button x:Name="NavDownload" Style="{StaticResource NavButton}" Click="NavDownload_Click" Background="#2D234A">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↓" Width="30" FontSize="18" Foreground="#C4B5FD"/>
                            <TextBlock Text="Загрузка музыки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="NavExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Width="30" FontSize="17" Foreground="#A5B4FC"/>
                            <TextBlock Text="Экспорт библиотеки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="NavRecovery_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="↻" Width="30" FontSize="19" Foreground="#6EE7B7"/>
                            <TextBlock Text="Восстановление" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="NavLogs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▤" Width="30" FontSize="17" Foreground="#FCD34D"/>
                            <TextBlock Text="Журналы и отчёты" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButton}" Click="NavSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" Width="30" FontSize="17" Foreground="#CBD5E1"/>
                            <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="#273449" Margin="4,0,4,14"/>
                    <TextBlock Text="СОСТОЯНИЕ" FontSize="10" CharacterSpacing="1.4"
                               Foreground="#64748B" Margin="5,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Margin="5,0,0,4">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="SidebarStatus" Text="Готов к работе" Margin="8,0,0,0"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Text="v0.3.0" Foreground="#64748B" FontSize="11" Margin="5,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="30,24,30,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" Text="Загрузка музыки" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="PageSubtitle" Text="Скачивай плейлисты и альбомы в свою музыкальную библиотеку."
                               Foreground="{StaticResource MutedBrush}" FontSize="13" Margin="0,5,0,0"/>
                </StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#162B2A"
                        BorderBrush="#28534B" BorderThickness="1" CornerRadius="20" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Локальный режим" FontSize="11" Foreground="#A7F3D0" Margin="7,0,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectedIndex="0">
                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Источник музыки" FontSize="17" FontWeight="SemiBold"/>
                                    <TextBlock Text="Вставь ссылку на плейлист, альбом, исполнителя или отдельную композицию."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,16"/>
                                    <TextBlock Text="ССЫЛКА ЯНДЕКС МУЗЫКИ" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="SourceUrlBox" Height="42" VerticalContentAlignment="Center"
                                             ToolTip="https://music.yandex.ru/playlists/..."/>
                                    <TextBlock Text="ПАПКА МУЗЫКАЛЬНОЙ БИБЛИОТЕКИ" Style="{StaticResource FieldLabel}" Margin="0,17,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="MusicFolderBox" Height="42" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Обзор…" Margin="8,0,0,0" Click="BrowseMusic_Click"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Параметры загрузки" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,16"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock Text="КАЧЕСТВО" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="QualityBox" SelectedIndex="0" Height="38">
                                                <ComboBoxItem Content="AAC / M4A 192 кбит/с" Tag="aac"/>
                                                <ComboBoxItem Content="FLAC — без потерь, если доступен" Tag="flac"/>
                                                <ComboBoxItem Content="MP3 — если поддерживается" Tag="mp3"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <TextBlock Text="ТЕКСТЫ ПЕСЕН" Style="{StaticResource FieldLabel}"/>
                                            <ComboBox x:Name="LyricsBox" SelectedIndex="0" Height="38">
                                                <ComboBoxItem Content="Не скачивать" Tag="0"/>
                                                <ComboBoxItem Content="Встроить в теги" Tag="1"/>
                                                <ComboBoxItem Content="Отдельные LRC-файлы" Tag="2"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <WrapPanel Margin="0,18,0,0">
                                        <CheckBox x:Name="DelayCheck" Content="Осторожный режим запросов" Margin="0,0,24,10"/>
                                        <CheckBox x:Name="AutoRetryCheck" Content="Повторять временные ошибки" IsChecked="True" Margin="0,0,24,10"/>
                                        <CheckBox x:Name="AutoFailoverCheck" Content="Автоматическое восстановление" IsChecked="True" Margin="0,0,24,10"/>
                                    </WrapPanel>
                                    <Border Background="#302717" BorderBrush="#5A4420" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
                                        <StackPanel>
                                            <CheckBox x:Name="BrowserFallbackCheck" Content="Разрешить последний резервный способ через браузерную сессию" />
                                            <Grid Margin="0,10,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Браузер:" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <ComboBox x:Name="BrowserBox" Grid.Column="1" SelectedIndex="0" Height="34">
                                                    <ComboBoxItem Content="Chrome" Tag="chrome"/>
                                                    <ComboBoxItem Content="Microsoft Edge" Tag="edge"/>
                                                    <ComboBoxItem Content="Firefox" Tag="firefox"/>
                                                    <ComboBoxItem Content="Brave" Tag="brave"/>
                                                </ComboBox>
                                                <TextBlock Grid.Column="2" Text="Используется только после явного разрешения."
                                                           Foreground="#D6B77A" FontSize="11" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Выполнение" FontSize="17" FontWeight="SemiBold"/>
                                            <TextBlock x:Name="DownloadStatus" Text="Готов к запуску"
                                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button x:Name="CancelButton" Content="Отменить" Click="Cancel_Click"
                                                    IsEnabled="False" Margin="0,0,8,0"/>
                                            <Button x:Name="DownloadButton" Content="↓  Начать загрузку"
                                                    Style="{StaticResource AccentButton}" Click="Download_Click"/>
                                        </StackPanel>
                                    </Grid>
                                    <ProgressBar x:Name="DownloadProgress" Value="0" Maximum="100" Margin="0,18,0,8"/>
                                    <TextBlock x:Name="ProgressCaption" Text="Ожидание" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                                    <TextBox x:Name="LiveOutputBox" Height="165" Margin="0,13,0,0"
                                             IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="11" Background="#0B1220"
                                             BorderBrush="#111827"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="Экспорт библиотеки" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Создай резервную копию состава плейлиста или подготовь список для импорта в другой медиасервис."
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,18"/>
                                    <TextBlock Text="ССЫЛКА НА ИСТОЧНИК" Style="{StaticResource FieldLabel}"/>
                                    <TextBox x:Name="ExportSourceBox" Height="42" VerticalContentAlignment="Center"/>
                                    <TextBlock Text="ПАПКА ДЛЯ ЭКСПОРТА" Style="{StaticResource FieldLabel}" Margin="0,18,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="ExportFolderBox" Height="42" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Обзор…" Click="BrowseExport_Click" Margin="8,0,0,0"/>
                                    </Grid>
                                    <Border Background="#172B2A" BorderBrush="#28534B" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,20,0,18">
                                        <StackPanel>
                                            <TextBlock Text="Файлы, которые будут созданы" FontWeight="SemiBold" Foreground="#A7F3D0"/>
                                            <TextBlock Text="CSV — импорт и таблицы    •    JSON — полный бэкап"
                                                       Foreground="{StaticResource TextBrush}" Margin="0,8,0,3" FontSize="12"/>
                                            <TextBlock Text="TXT — простой список    •    XML — структурированный список"
                                                       Foreground="{StaticResource TextBrush}" FontSize="12"/>
                                            <TextBlock Text="Аудиофайлы не скачиваются. Токен не включается в экспорт."
                                                       Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="ExportButton" Content="▤  Создать резервную копию" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Left" Click="Export_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Восстановление неудачных треков" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Выбери журнал загрузки. Downloader Plus восстановит только известные проблемные позиции, не перезаписывая существующие нормальные файлы."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <WrapPanel>
                                    <Button Content="Обновить список" Click="RefreshLogs_Click" Margin="0,0,10,0"/>
                                    <Button x:Name="RetryButton" Content="↻  Восстановить выбранный запуск" Style="{StaticResource AccentButton}"
                                            Click="Retry_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
                            <ListBox x:Name="RecoveryLogsList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" FontSize="13"
                                     DisplayMemberPath="DisplayName"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22" Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Журналы и отчёты" FontSize="19" FontWeight="SemiBold"/>
                                <TextBlock Text="Журналы, очереди восстановления и CSV-отчёты помогают понять, что произошло с каждой композицией."
                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,14"/>
                                <WrapPanel>
                                    <Button Content="Обновить" Click="RefreshLogs_Click" Margin="0,0,8,0"/>
                                    <Button Content="Открыть папку журналов" Click="OpenLogsFolder_Click" Margin="0,0,8,0"/>
                                    <Button Content="Открыть выбранный файл" Click="OpenSelectedLog_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="16">
                            <ListBox x:Name="AllLogsList" Background="Transparent" BorderThickness="0"
                                     Foreground="{StaticResource TextBrush}" FontSize="13"
                                     DisplayMemberPath="DisplayName"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="24" Margin="0,0,0,15">
                                <StackPanel>
                                    <TextBlock Text="Настройки приложения" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Секреты и параметры сохраняются в профиле Windows, отдельно от каталога программы."
                                               Foreground="{StaticResource MutedBrush}" Margin="0,7,0,20" TextWrapping="Wrap"/>
                                    <TextBlock Text="ТОКЕН ЯНДЕКС МУЗЫКИ" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="TokenBox" Height="42" VerticalContentAlignment="Center"/>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Content="Сохранить токен" Style="{StaticResource AccentButton}" Click="SaveToken_Click" Margin="0,0,8,0"/>
                                        <Button Content="Удалить сохранённый токен" Click="DeleteToken_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="TokenStatus" Text="Токен не настроен"
                                               Foreground="{StaticResource WarningBrush}" FontSize="12" Margin="0,12,0,0"/>
                                    <Border Height="1" Background="#374151" Margin="0,22,0,18"/>
                                    <TextBlock Text="ПАПКА МУЗЫКАЛЬНОЙ БИБЛИОТЕКИ" Style="{StaticResource FieldLabel}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="SettingsMusicFolderBox" Height="42" VerticalContentAlignment="Center"/>
                                        <Button Grid.Column="1" Content="Обзор…" Click="BrowseSettingsMusic_Click" Margin="8,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="Сохранённая папка применяется и к консольному, и к графическому запуску."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,8,0,0"/>
                                    <Button Content="Сохранить настройки" Click="SaveSettings_Click" Style="{StaticResource AccentButton}"
                                            HorizontalAlignment="Left" Margin="0,18,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="22">
                                <StackPanel>
                                    <TextBlock Text="Безопасность и совместимость" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="• Токен шифруется Windows DPAPI для текущего пользователя."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,10,0,3"/>
                                    <TextBlock Text="• Основной загрузчик получает токен через временную переменную окружения — секрет не передаётся в аргументах командной строки."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                    <TextBlock Text="• Браузерная сессия используется только после отдельного разрешения."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3"/>
                                    <TextBlock Text="• Для работы графического приложения используется встроенный Windows PowerShell; аудиозагрузку выполняют те же backend-модули."
                                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,12,0,0">
                <TextBlock x:Name="FooterStatus" Text="Готово" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="Downloader Plus • Windows" Foreground="#64748B" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
